#!/bin/sh
#
# Gradle start up script for POSIX generated by Gradle.
#
# This is a standard Gradle Wrapper script (lightly trimmed) that bootstraps
# Gradle using gradle/wrapper/gradle-wrapper.jar and the distributionUrl
# defined in gradle/wrapper/gradle-wrapper.properties.
#
# IMPORTANT:
# - This project pins Gradle via gradle-wrapper.properties (Gradle 8.12).
# - This script must not delegate to a system `gradle` binary (CI may not have it).

##############################################################################
# Resolve links: $0 may be a link
##############################################################################
app_path=$0

# Need this for relative symlinks.
while
  APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; empty if no leading path
  [ -h "$app_path" ]
do
  ls=$(ls -ld "$app_path")
  link=${ls#*' -> '}
  case $link in
    /*) app_path=$link ;;
    *) app_path=$APP_HOME$link ;;
  esac
done

APP_HOME=$(cd "${APP_HOME:-./}" && pwd -P) || exit 1
APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}

##############################################################################
# JVM options
##############################################################################
DEFAULT_JVM_OPTS='-Xmx64m -Xms64m'

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
  if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
    JAVACMD="$JAVA_HOME/jre/sh/java"
  else
    JAVACMD="$JAVA_HOME/bin/java"
  fi
  if [ ! -x "$JAVACMD" ] ; then
    echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
    echo "Please set JAVA_HOME in your environment to match the location of your Java installation." >&2
    exit 1
  fi
else
  JAVACMD=java
fi

##############################################################################
# Locate wrapper JAR
##############################################################################
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ] ; then
  echo "ERROR: Gradle wrapper JAR not found at: $WRAPPER_JAR" >&2
  echo "Make sure gradle/wrapper/gradle-wrapper.jar is committed to the repository." >&2
  exit 1
fi

##############################################################################
# Build the java command line
##############################################################################
# Collect all arguments for the java command, following the shell quoting and substitution rules.
set -- \
  -Dorg.gradle.appname="$APP_BASE_NAME" \
  -classpath "$WRAPPER_JAR" \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"

# Add default JVM options.
# shellcheck disable=SC2086
exec "$JAVACMD" $DEFAULT_JVM_OPTS "$@"
